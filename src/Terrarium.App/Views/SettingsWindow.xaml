<Window x:Class="Terrarium.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terrarium Settings"
        Width="680" Height="580" MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSave" Margin="0" />
        </StackPanel>

        <TabControl Background="White" BorderBrush="{StaticResource Line}">
            <!-- General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,4,16,16">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="The terrarium" />
                        <CheckBox x:Name="AlwaysOnTopBox" Content="Keep it above other windows (and the taskbar)" />
                        <CheckBox x:Name="HideFullscreenBox" Content="Hide it while a game, video or presentation is fullscreen" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                   Text="Animations always pause during fullscreen apps and while you're away, to save power." />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start Terrarium when I sign in to Windows" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Tracking" />
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Count me as away after" VerticalAlignment="Center" />
                            <Slider Grid.Row="0" Grid.Column="1" x:Name="IdleSlider" Minimum="1" Maximum="15"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=IdleSlider, StringFormat='{}{0:0} min'}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}"
                                       Text="With no keyboard or mouse input for this long, time stops counting either way." />

                            <TextBlock Grid.Row="2" Text="Grace period before wilting" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="GraceSlider" Minimum="0" Maximum="15"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=GraceSlider, StringFormat='{}{0:0} min'}" />
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Hint}"
                                       Text="A quick peek at a distraction is fine. Plants only start drooping after this much continuous distraction, and recover when you get back to work." />
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Recaps" />
                        <CheckBox x:Name="DailyRecapBox" Content="Show a daily recap of my focused time" />
                        <CheckBox x:Name="WeeklyRecapBox" Content="Show a weekly recap on Fridays" />
                        <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                            <TextBlock Text="Show recaps at" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="RecapHourBox" Width="110" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Apps & sites -->
            <TabItem Header="Apps &amp; sites">
                <Grid Margin="16,10,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Hint}" FontSize="12.5">
                        Pick what counts as <Run FontWeight="SemiBold" Foreground="{StaticResource Leaf}">focus</Run> and what counts as a
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Clay}">distraction</Run>. Anything else is neutral.
                        Window-title rules catch websites in any browser (e.g. "YouTube") and take priority over app rules.
                    </TextBlock>

                    <DockPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Your rules" FontWeight="SemiBold" Margin="0,4,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Remove" Click="OnRemoveRule" />
                            <Button Content="Restore defaults" Click="OnRestoreDefaults" Margin="0" />
                        </StackPanel>
                        <ListView x:Name="RulesList" SelectionMode="Extended" BorderBrush="{StaticResource Line}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Counts as" Width="80" DisplayMemberBinding="{Binding KindText}" />
                                    <GridViewColumn Header="When" Width="105" DisplayMemberBinding="{Binding TargetText}" />
                                    <GridViewColumn Header="Pattern" Width="120" DisplayMemberBinding="{Binding Pattern}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Apps you've used recently" FontWeight="SemiBold" Margin="0,4,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Mark as focus" Click="OnMarkFocus" />
                            <Button Content="Mark as distraction" Click="OnMarkDistraction" Margin="0" />
                        </StackPanel>
                        <Grid>
                            <ListView x:Name="RecentList" SelectionMode="Extended" BorderBrush="{StaticResource Line}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="App" Width="105" DisplayMemberBinding="{Binding ProcessName}" />
                                        <GridViewColumn Header="Last window" Width="190" DisplayMemberBinding="{Binding LastTitle}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="RecentEmpty" Style="{StaticResource Hint}" Margin="14" TextAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Text="Apps show up here as you use them while Terrarium is running." />
                        </Grid>
                    </DockPanel>

                    <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="10" Background="{StaticResource Paper}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Add a rule:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="NewKindBox" Width="100" Margin="0,0,6,0" SelectedIndex="0">
                                <ComboBoxItem Content="Focus" />
                                <ComboBoxItem Content="Distraction" />
                            </ComboBox>
                            <ComboBox x:Name="NewTargetBox" Width="150" Margin="0,0,6,0" SelectedIndex="1">
                                <ComboBoxItem Content="App name is" />
                                <ComboBoxItem Content="Window title has" />
                            </ComboBox>
                            <TextBox x:Name="NewPatternBox" Width="140" Margin="0,0,6,0" VerticalContentAlignment="Center" />
                            <Button Content="Add" Click="OnAddRule" MinWidth="60" Margin="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- About -->
            <TabItem Header="Updates &amp; data">
                <StackPanel Margin="16,4,16,16">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" />
                    <TextBlock x:Name="VersionText" Margin="0,0,0,6" />
                    <CheckBox x:Name="CheckUpdatesBox" Content="Check GitHub for new versions once a day" />
                    <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,8"
                               Text="This is the only time Terrarium uses the internet. It asks GitHub for the latest release of larosa023/Terrarium and sends nothing about you." />
                    <Button Content="Check now" HorizontalAlignment="Left" Click="OnCheckUpdates" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Your data" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Everything stays on this PC in two small files (settings.json and garden.json). Terrarium only notes which app is in front and for how long; window titles are matched against your rules and never saved to disk." />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Open data folder" Click="OnOpenData" />
                        <Button Content="Reset garden…" Click="OnResetGarden" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
