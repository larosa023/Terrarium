<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic: garden engine, classification, storage, pixel renderer, update checks.
       Deliberately has zero package dependencies so it builds and tests anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Terrarium.Core</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
