<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool: renders preview sheets of the terrarium art to PNG and regenerates the app icon.
       Runs on any OS. See README "Previewing the art". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Terrarium.Core\Terrarium.Core.csproj" />
  </ItemGroup>
</Project>
