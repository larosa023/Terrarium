<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free test runner (plain console app); exits non-zero on failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Terrarium.Core\Terrarium.Core.csproj" />
  </ItemGroup>
</Project>
